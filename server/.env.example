# ── Express Server ─────────────────────────────
PORT=5000
NODE_ENV=development

# ── MySQL ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_events

# ── JWT ────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── PHP Service ────────────────────────────────
PHP_SERVICE_URL=http://localhost:8080

# ── CORS ───────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Uploads ────────────────────────────────────
UPLOAD_DIR=./uploads
